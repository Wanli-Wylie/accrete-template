{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACCRETE template source definition v1",
  "type": "object",
  "required": ["schema_version", "template_id", "project_formats", "cli_contract", "default_profiles", "profiles", "skills", "ownership"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "template_id": { "const": "accrete-foundation" },
    "project_formats": { "type": "object", "required": ["min", "max"] },
    "cli_contract": { "const": "accrete-template-cli/v1" },
    "default_profiles": { "type": "array", "uniqueItems": true, "items": { "enum": ["codex", "claude"] } },
    "profiles": { "type": "object", "required": ["codex", "claude"] },
    "skills": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "pattern": "^accrete-[a-z]+$" } },
    "ownership": { "type": "object", "required": ["default", "seed_once", "managed_blocks", "profile_files"], "properties": {
      "default": { "const": "managed-file" },
      "seed_once": { "type": "array", "items": { "type": "string" } },
      "managed_blocks": { "type": "array", "items": { "type": "object", "required": ["path", "start", "end"], "properties": { "path": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" } }, "additionalProperties": false } },
      "profile_files": { "type": "object", "additionalProperties": { "enum": ["codex", "claude"] } }
    }, "additionalProperties": false }
  },
  "additionalProperties": false
}
