# Shared project configuration example. This is not an initialized project.
# `npx accrete-kit@latest create` generates project_id; preserve it in every clone.
# See ../docs/configuration.md.
format = 1
project_id = "GENERATED_AT_WORKSPACE_CREATION"
name = "project-name"
timezone = "UTC"

[paths]
metadata = ".accrete/objects"
results = "results"
memory = "memory"
tool_sources = "tools"
scratch = "scratch"

[locations.working]
kind = "filesystem"
purpose = "Current scientific products retained in place"

[locations.archive]
kind = "rclone"
purpose = "Selected retained products"

# Add environment guidance only for an existing project capability.
# [environments.jax-gpu]
# description = "Project-maintained execution environment"
# instructions = "tools/model-execution/references/environment.md"
